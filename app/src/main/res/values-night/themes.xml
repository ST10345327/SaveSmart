<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SaveSmart" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Design System Colors - Dark Mode Optimized -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#1E3A8A</item> <!-- Deep Blue for Dark Mode -->
        <item name="colorOnPrimaryContainer">#DBEAFE</item>

        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Material 3 Customization -->
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorSurfaceVariant">#334155</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Global Text Case Fix -->
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:editTextStyle">@style/Widget.SaveSmart.EditText</item>
    </style>

    <!-- Splash Screen Theme (Dark Mode) -->
    <style name="Theme.SaveSmart.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


</resources>